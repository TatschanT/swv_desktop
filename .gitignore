# Python
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/

# PyInstaller build output
# Regenerated by every `pyinstaller SWV.spec` run. Without these two, a build
# machine's `git status` fills with hundreds of untracked files and real changes
# get lost in the noise. SWV.spec itself IS tracked -- it is hand-edited (splash,
# icon, datas) and must never be regenerated by running `pyinstaller main.py`.
build/
dist/
*.manifest

# OS generated files
.DS_Store
Thumbs.db
